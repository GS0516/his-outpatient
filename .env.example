# ==========================================================================
# 环境变量模板：复制为 .env 后填写，.env 不入库
# ==========================================================================

# 应用
APP_ENV=development
APP_VERSION=3.0.0

# 数据库：默认 SQLite（卷 /data/his.db）；切 PostgreSQL 用下面这行
DATABASE_URL=sqlite:////data/his.db
# DATABASE_URL=postgresql+psycopg2://his:his_dev_password@db:5432/his
POSTGRES_DB=his
POSTGRES_USER=his
POSTGRES_PASSWORD=his_dev_password

# 会话令牌（生产必须替换为 32 字节以上随机值）
JWT_SECRET=
SESSION_HOURS=8

# 允许的前端来源（不要用 *）
ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173

# 智能分诊大模型接口（留空则使用本地规则降级）
AI_ENDPOINT=
AI_KEY=
AI_TIMEOUT=10

# ==========================================================================
# 安全开关（上线必看）
# ==========================================================================
# 生产环境请改为 prod：自动关闭 /docs、/redoc、/openapi.json，
# 关闭启动自检告警中的开发提示，并启用 HSTS / no-store
# APP_ENV=prod
# 若确需在生产保留接口文档，显式打开（默认关闭）
EXPOSE_DOCS=0

# 首次初始化口令：不填则开发环境用演示口令、生产环境随机生成并打印一次
# 已存在数据库时不会覆盖，需另行改密
SEED_DOCTOR_PASSWORD=
SEED_ADMIN_PASSWORD=

# 登录失败限速与临时锁定
LOGIN_MAX_FAILS=5
LOGIN_LOCK_SECONDS=900
LOGIN_WINDOW_SECONDS=900

